# Copy this file to ".env" for local testing, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit your real .env file (it is listed in .gitignore).
RESEND_API_KEY=
NOTIFY_EMAIL=info@beyondmatrix.in
FROM_EMAIL=Beyondmatrix Website <website@beyondmatrix.in>
SEND_ACKNOWLEDGEMENT=false
# Optional: local port (default 3000)
# PORT=3000
